# ==============================================================================
# SENTINEL SOC — Environment Configuration Template (.env.example)
# ==============================================================================
# All services default to 100% Free & Open-Source options.
# Zero paid services, subscriptions, or credit cards are required to run Sentinel SOC.
# ==============================================================================

# Application Environment
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Security Secrets (Generate using: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=sentinel_soc_super_secret_development_key_min_32_bytes_long!!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration
# Default: SQLite file database (sentinel.db) for zero-dependency native execution.
# For Docker / PostgreSQL: postgresql://sentinel:password@localhost:5432/sentinel
DATABASE_URL=sqlite:///./sentinel.db

# Optional Redis In-Memory Cache (Defaults to None if empty; in-memory fallback used)
REDIS_URL=

# CORS Allowed Origins (Comma-separated or JSON array)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Trusted Proxies (Comma-separated client IPs or CIDRs of reverse proxies allowed to forward X-Forwarded-For)
TRUSTED_PROXIES=127.0.0.1,::1

# Application Logging
LOG_LEVEL=INFO
LOG_FILE=logs/sentinel.log

# ==============================================================================
# AI PROVIDER SETTINGS (STRICT FREE-TIER ARCHITECTURE)
# ==============================================================================
# Options: "gemini", "local", "fallback" (default: "fallback" - deterministic rule engine)
AI_PROVIDER=fallback

# Google Gemini API Settings (Free Tier only — https://aistudio.google.com/)
# Model is fully configurable. Sentinel SOC NEVER auto-upgrades to paid tiers.
# If quota is exhausted (HTTP 429), Sentinel returns a graceful fallback message.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Local AI Provider (Ollama / LocalAI / vLLM — 100% Free & Offline)
LOCAL_AI_URL=http://localhost:11434
LOCAL_AI_MODEL=llama3

# ==============================================================================
# THREAT INTELLIGENCE APIS (OPTIONAL FREE TIERS)
# ==============================================================================
# Leave blank to use cached/local intelligence. Features remain operational without keys.
# AbuseIPDB Free Tier (1,000 checks/day): https://www.abuseipdb.com/
ABUSEIPDB_API_KEY=

# GreyNoise Community API (Free): https://viz.greynoise.io/
GREYNOISE_API_KEY=

# AlienVault OTX Community (Free): https://otx.alienvault.com/
OTX_API_KEY=

# Spamhaus DQS Free Community Key (Up to 300,000 queries/month): https://www.spamhaus.com/
SPAMHAUS_DQS_KEY=

# ==============================================================================
# EMAIL NOTIFICATIONS (OPTIONAL)
# ==============================================================================
# If disabled, notifications are recorded in-app and printed to console in dev mode.
SMTP_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@sentinelsoc.local

# ==============================================================================
# FRONTEND CONFIGURATION
# ==============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
