# ==============================================================================
# SENTINEL SOC — Frontend .gitignore
# ==============================================================================

# Dependencies
node_modules/
/.pnp
.pnp.js
.yarn/install-state.gz

# Next.js Build Outputs
/.next/
/out/
/build

# Testing & E2E Reports
/coverage
/test-results/
/playwright-report/

# Virtual Environments (if created in frontend)
venv/
.venv/

# Environment Variables
.env
.env*.local
.env.production
.env.development
!.env.example

# Vercel Deployment Metadata
.vercel

# TypeScript & Debug Logs
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Operating System & Certificates
.DS_Store
Thumbs.db
*.pem
